{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "actions"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "action",
          "args_json"
        ],
        "properties": {
          "agent": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{1,64}$"
          },
          "action": {
            "type": "string",
            "enum": [
              "EXEC",
              "FETCH",
              "WORLD",
              "STATUS",
              "SPEND",
              "RECONCILE"
            ]
          },
          "args_json": {
            "type": "string",
            "description": "Tool arguments encoded as one JSON object string, preserving arbitrary nested fields."
          }
        }
      }
    }
  }
}
