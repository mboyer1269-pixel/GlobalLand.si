{"post_stream":{"posts":[{"id":188206,"name":"Muhammad Umar","username":"Muhammad_Umar","avatar_template":"/user_avatar/forum.manager.io/muhammad_umar/{size}/29988_2.png","created_at":"2022-11-26T04:26:20.229Z","cooked":"\u003cp\u003eHi, is there any way to import sales invoices from .csv file?\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":7,"updated_at":"2022-11-26T04:26:20.229Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":118,"reads":56,"readers_count":55,"score":601.2,"yours":false,"topic_id":44200,"topic_slug":"import-multiple-sales-invoices-form-csv-file","display_username":"Muhammad Umar","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":15760,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/import-multiple-sales-invoices-form-csv-file/44200/1","calendar_details":[],"reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":188207,"name":null,"username":"Patch","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/p/a183cd/{size}.png","created_at":"2022-11-26T04:40:51.004Z","cooked":"\u003cp\u003eProbably not as easily as you will have hoped but if you wanted to persue that approach read this section of the guides\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBatch Operations:\u003c/strong\u003e \u003ca href=\"https://www.manager.io/guides/9572\"\u003eUse Batch Create and Batch Update functions\u003c/a\u003e | \u003ca href=\"https://www.manager.io/guides/16464\"\u003eUse the Batch Delete function\u003c/a\u003e | \u003ca href=\"https://www.manager.io/guides/32659\"\u003eUse the Batch View function\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eYou will need to\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003ecreate some representative invoices in Manager manually\u003c/li\u003e\n\u003cli\u003eUse batch update to understand the details of the format you will need too produce\u003c/li\u003e\n\u003cli\u003eUse an external program to format your data to that required to import it into Manager (the batch create format is identical to batch update except it does not have the final “Key” field).\u003c/li\u003e\n\u003cli\u003eUse batch create to import your invoices into Manager\u003c/li\u003e\n\u003c/ol\u003e","post_number":2,"post_type":1,"posts_count":7,"updated_at":"2022-11-26T04:40:51.004Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":54,"readers_count":53,"score":15.8,"yours":false,"topic_id":44200,"topic_slug":"import-multiple-sales-invoices-form-csv-file","display_username":null,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://www.manager.io/guides/9572","internal":false,"reflection":false,"title":"Use Batch Create and Batch Update functions | Manager","clicks":15},{"url":"https://www.manager.io/guides/32659","internal":false,"reflection":false,"title":"Use the Batch View function | Manager","clicks":3},{"url":"https://www.manager.io/guides/16464","internal":false,"reflection":false,"title":"Use the Batch Delete function | Manager","clicks":1}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":9454,"hidden":false,"trust_level":2,"del