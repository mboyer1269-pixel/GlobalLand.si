asko","username":"lubos","avatar_template":"/user_avatar/forum.manager.io/lubos/{size}/62798_2.png","created_at":"2022-12-03T22:32:47.043Z","cooked":"\u003caside class=\"quote no-group\" data-username=\"Genti_Ge\" data-post=\"3\" data-topic=\"44200\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://sea1.discourse-cdn.com/flex019/user_avatar/forum.manager.io/genti_ge/48/14096_2.png\" class=\"avatar\"\u003e Genti_Ge:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003ealso keep in mind that if yo have multiple lines in the invoice they are to be included in one single cell\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eI’m going to be changing that soon. Even though this will increase number of columns substantially, it is important there is 1:1 match between spreadsheet cells and text fields in Manager.\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":7,"updated_at":"2022-12-03T22:32:47.043Z","reply_count":1,"reply_to_post_number":3,"quote_count":1,"incoming_link_count":0,"reads":46,"readers_count":45,"score":14.2,"yours":false,"topic_id":44200,"topic_slug":"import-multiple-sales-invoices-form-csv-file","display_username":"Lubos Hasko","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":false,"admin":true,"staff":true,"user_id":2,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/import-multiple-sales-invoices-form-csv-file/44200/4","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction